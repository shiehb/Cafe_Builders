// =============================================================================
// Proposed schema.prisma - Catalog Normalization Migration
// Migrates in-memory Maps -> PostgreSQL as single source of truth
// Preserves all existing Product / Order / OrderItem fields
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  READY
  COMPLETED
}

enum PaymentMethod {
  QRPH
  CASH
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

/// Only two selection modes are permitted application-wide.
/// Using a Prisma enum prevents invalid values from ever reaching the DB.
enum SelectionMode {
  SINGLE
  MULTIPLE
}

/// Promotion discount model. Percent discounts are applied against the order
/// subtotal; Fixed discounts are absolute amount reductions.
enum PromotionDiscountType {
  PERCENT
  FIXED
}

// ---------------------------------------------------------------------------
// CATEGORY (unchanged)
// ---------------------------------------------------------------------------

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

// ---------------------------------------------------------------------------
// INGREDIENT
// Replaces ingredientsStore Map
// ---------------------------------------------------------------------------

model Ingredient {
  id          String              @id
  name        String
  isAvailable Boolean             @default(true)
  isArchived  Boolean             @default(false)
  products    ProductIngredient[]
  options     CustomizationOption[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("ingredients")
}

// ---------------------------------------------------------------------------
// CUSTOMIZATION GROUP
// Replaces customizationGroupsStore Map
// ---------------------------------------------------------------------------

model CustomizationGroup {
  id            String                      @id
  name          String
  selectionMode SelectionMode               @default(SINGLE)
  isRequired    Boolean                     @default(false)
  sortOrder     Int                         @default(0)
  isActive      Boolean                     @default(true)
  isArchived    Boolean                     @default(false)
  /// System-defined groups (e.g. 'SUGAR', 'ICE') that Admin cannot create/edit/archive.
  systemKey     String?                     @unique
  options       CustomizationOption[]
  products      ProductCustomizationGroup[]
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  @@map("customization_groups")
}

// ---------------------------------------------------------------------------
// CUSTOMIZATION OPTION
// Replaces customizationOptionsStore Map
// ---------------------------------------------------------------------------

model CustomizationOption {
  id             String                       @id
  groupId        String
  group          CustomizationGroup           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name           String
  priceModifier  Decimal                      @default(0) @db.Decimal(10, 2)
  isActive       Boolean                      @default(true)
  isArchived     Boolean                      @default(false)
  /// Optional link to a stocked Ingredient (milk alternatives, add-ons).
  /// Ingredient-backed options are reusable ACROSS groups/products; the
  /// (groupId, ingredientId) unique guard only forbids duplicate options for
  /// the same ingredient WITHIN one group. NOT unique globally by design.
  ingredientId   String?
  ingredient     Ingredient?                  @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  productOptions ProductCustomizationOption[]
  modifiers      OrderItemModifier[]
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  @@index([groupId])
  @@index([ingredientId])
  @@unique([groupId, ingredientId])
  @@map("customization_options")
}

// ---------------------------------------------------------------------------
// PRODUCT
// ADDED:   manualAvailability, isArchived, join-table relations
// CHANGED: price Float -> Decimal
// PRESERVED: all existing fields
//
// AVAILABILITY RULE (enforced by server, not independently editable):
//   isAvailable = manualAvailability !== false
//                 && no required ingredient is unavailable
//
// manualAvailability: the sole admin-controlled availability toggle.
//   Persisted here so the rule is evaluated entirely from DB state.
// isAvailable: always WRITTEN by the server after computing the above rule.
//   Kept persisted for: Supabase RLS queries, Supabase read fallback,
//   and the existing API surface. Admin UI must never set isAvailable
//   directly -- it sets manualAvailability and the server recomputes.
// ---------------------------------------------------------------------------

model Product {
  id                  String                       @id @default(cuid())
  name                String
  description         String
  price               Decimal                      @db.Decimal(10, 2)
  imageUrl            String
  categoryId          String
  /// RESTRICT: a category with products must be archived, not deleted.
  category            Category                     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  isAvailable         Boolean                      @default(true)
  manualAvailability  Boolean                      @default(true)
  popular             Boolean                      @default(false)
  isArchived          Boolean                      @default(false)
  orderItems          OrderItem[]
  ingredients         ProductIngredient[]
  customizationGroups ProductCustomizationGroup[]
  allowedOptions      ProductCustomizationOption[]
  promotions          PromotionProduct[]
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@index([categoryId])
  @@map("products")
}

// ---------------------------------------------------------------------------
// JOIN TABLE: Product <-> Ingredient
// Replaces product.ingredientIds string array
// ---------------------------------------------------------------------------

model ProductIngredient {
  productId    String
  ingredientId String
  isRequired   Boolean    @default(true)
  /// Marks the product's BASE ingredient for a customization group (e.g. base milk).
  /// The base is shown by default at zero surcharge and is never selectable as an
  /// alternative. Plain recipe ingredients leave this false.
  isBase       Boolean    @default(false)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Restrict: ingredients must be archived (isArchived=true), not deleted.
  /// Deleting an ingredient that has active product mappings must fail at the DB level.
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([productId, ingredientId])
  @@map("product_ingredients")
}

// ---------------------------------------------------------------------------
// JOIN TABLE: Product <-> CustomizationGroup
// Replaces product.enabledCustomizationGroups string array
// ---------------------------------------------------------------------------

model ProductCustomizationGroup {
  productId String
  groupId   String
  sortOrder Int                @default(0)
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     CustomizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
  @@map("product_customization_groups")
}

// ---------------------------------------------------------------------------
// JOIN TABLE: Product <-> CustomizationOption (allowed options per product)
// Replaces product.allowedOptionIds string array
// ---------------------------------------------------------------------------

model ProductCustomizationOption {
  productId String
  optionId  String
  /// Product-specific customer surcharge for this option on this product.
  /// Overrides the option's global priceModifier when this row exists.
  surcharge Decimal  @default(0) @db.Decimal(10, 2)
  /// Deterministic ordering of options within the product's customization.
  sortOrder Int      @default(0)
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  option    CustomizationOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([productId, optionId])
  @@map("product_customization_options")
}

// ---------------------------------------------------------------------------
// ORDER
// CHANGED: subtotal, serviceFee, totalAmount Float -> Decimal
// PRESERVED: all existing fields
// ---------------------------------------------------------------------------

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  status          OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod   PaymentMethod
  paymentIntentId String? @unique
  paymentMethodId String?
  qrCodeUrl       String?
  customerName    String?
  orderType       OrderType     @default(DINE_IN)
  notes           String?
  subtotal        Decimal       @db.Decimal(10, 2)
  serviceFee      Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2)
  /// Set when the order enters PAID (payment confirmed).
  paidAt          DateTime?
  /// Snapshot of the applied promo (single promo per order); null when none.
  promoCode       String?
  promoDiscount   Decimal       @default(0) @db.Decimal(10, 2)
  promotionId     String?
  promotion       Promotion?    @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

// ---------------------------------------------------------------------------
// PROMOTION
// Server-side promotion definitions. This is the authoritative promo source;
// client-side discount computation must be validated/re-applied here.
// One promo code per order is enforced at the service layer via the single
// promotionId/ promoCode on Order.
// ---------------------------------------------------------------------------

model Promotion {
  id               String               @id @default(cuid())
  code             String               @unique
  isActive         Boolean              @default(true)
  discountType     PromotionDiscountType
  discountValue    Decimal              @db.Decimal(10, 2)
  minOrderAmount   Decimal?             @db.Decimal(10, 2)
  maxDiscountAmount Decimal?            @db.Decimal(10, 2)
  startAt          DateTime?
  endAt            DateTime?
  usageLimit       Int?
  timesUsed        Int                  @default(0)
  perCustomerLimit Int?
  eligibleProducts PromotionProduct[]
  orders           Order[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([isActive])
  @@map("promotions")
}

model PromotionProduct {
  promotionId String
  productId   String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@map("promotion_products")
}

// ---------------------------------------------------------------------------
// ORDER ITEM
// CHANGED: unitPrice, subtotal Float -> Decimal
// PRESERVED: customizations Json? (backward compat for historical orders)
// ADDED:   modifiers relation -> OrderItemModifier
// ---------------------------------------------------------------------------

model OrderItem {
  id             String              @id @default(cuid())
  orderId        String
  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String
  unitPrice      Decimal             @db.Decimal(10, 2)
  quantity       Int                 @default(1)
  subtotal       Decimal             @db.Decimal(10, 2)
  customizations Json?
  notes          String?
  modifiers      OrderItemModifier[]
  createdAt      DateTime            @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// ORDER ITEM MODIFIER (NEW)
// Structured snapshot of each selected customization option per order item.
// Stores groupName/optionName/priceAdjustment as snapshot values so
// historical orders remain accurate even if catalog options are edited/deleted.
// ---------------------------------------------------------------------------

model OrderItemModifier {
  id              String               @id @default(cuid())
  orderItemId     String
  orderItem       OrderItem            @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  optionId        String?
  option          CustomizationOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  groupName       String
  optionName      String
  priceAdjustment Decimal              @db.Decimal(10, 2)
  quantity        Int                  @default(1)
  createdAt       DateTime             @default(now())

  @@index([orderItemId])
  @@index([optionId])
  @@map("order_item_modifiers")
}
