SUPABASE_URL=
PAYMONGO_SIMULATION_ENABLED=
# Set to "true" to explicitly allow SIMULATED PayMongo behavior when no real
# PAYMONGO_SECRET_KEY is configured: (a) the authenticated dev-only webhook
# simulation endpoints (/api/simulate-webhook and aliases), and (b) SIMULATED
# QR payments from order creation. Defaults to OFF. When a real key IS set,
# payment generation is LIVE-FIRST and FAIL-CLOSED (F11-A1): a provider failure
# throws and never silently falls back to a simulated QR.
PAYMONGO_WEBHOOK_SECRET_KEY=
# F11-A3. Dev-only explicit override to accept UNSIGNED PayMongo webhooks when
# no PAYMONGO_WEBHOOK_SECRET_KEY is set. Defaults to OFF. When a webhook secret
# IS configured, signatures are ALWAYS required regardless of this flag. In
# production, unsigned events are always rejected.
PAYMONGO_ALLOW_UNSIGNED_WEBHOOKS_DEV=
