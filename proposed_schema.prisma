// =============================================================================
// Proposed schema.prisma - Catalog Normalization Migration
// Migrates in-memory Maps -> PostgreSQL as single source of truth
// Preserves all existing Product / Order / OrderItem fields
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  READY
  COMPLETED
}

enum PaymentMethod {
  QRPH
  CASH
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

/// Only two selection modes are permitted application-wide.
/// Using a Prisma enum prevents invalid values from ever reaching the DB.
enum SelectionMode {
  SINGLE
  MULTIPLE
}

// ---------------------------------------------------------------------------
// CATEGORY (unchanged)
// ---------------------------------------------------------------------------

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

// ---------------------------------------------------------------------------
// INGREDIENT
// Replaces ingredientsStore Map
// ---------------------------------------------------------------------------

model Ingredient {
  id          String             @id
  name        String
  isAvailable Boolean            @default(true)
  isArchived  Boolean            @default(false)
  products    ProductIngredient[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("ingredients")
}

// ---------------------------------------------------------------------------
// CUSTOMIZATION GROUP
// Replaces customizationGroupsStore Map
// ---------------------------------------------------------------------------

model CustomizationGroup {
  id            String                      @id
  name          String
  selectionMode SelectionMode               @default(SINGLE)
  isRequired    Boolean                     @default(false)
  sortOrder     Int                         @default(0)
  isActive      Boolean                     @default(true)
  isArchived    Boolean                     @default(false)
  options       CustomizationOption[]
  products      ProductCustomizationGroup[]
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  @@map("customization_groups")
}

// ---------------------------------------------------------------------------
// CUSTOMIZATION OPTION
// Replaces customizationOptionsStore Map
// ---------------------------------------------------------------------------

model CustomizationOption {
  id             String                       @id
  groupId        String
  group          CustomizationGroup           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name           String
  priceModifier  Decimal                      @default(0) @db.Decimal(10, 2)
  isActive       Boolean                      @default(true)
  isArchived     Boolean                      @default(false)
  productOptions ProductCustomizationOption[]
  modifiers      OrderItemModifier[]
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  @@map("customization_options")
}

// ---------------------------------------------------------------------------
// PRODUCT
// ADDED:   manualAvailability, isArchived, join-table relations
// CHANGED: price Float -> Decimal
// PRESERVED: all existing fields
//
// AVAILABILITY RULE (enforced by server, not independently editable):
//   isAvailable = manualAvailability !== false
//                 && no required ingredient is unavailable
//
// manualAvailability: the sole admin-controlled availability toggle.
//   Persisted here so the rule is evaluated entirely from DB state.
// isAvailable: always WRITTEN by the server after computing the above rule.
//   Kept persisted for: Supabase RLS queries, Supabase read fallback,
//   and the existing API surface. Admin UI must never set isAvailable
//   directly -- it sets manualAvailability and the server recomputes.
// ---------------------------------------------------------------------------

model Product {
  id                 String                      @id @default(cuid())
  name               String
  description        String
  price              Decimal                     @db.Decimal(10, 2)
  imageUrl           String
  categoryId         String
  category           Category                    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isAvailable        Boolean                     @default(true)
  manualAvailability Boolean                     @default(true)
  popular            Boolean                     @default(false)
  isArchived         Boolean                     @default(false)
  orderItems         OrderItem[]
  ingredients        ProductIngredient[]
  customizationGroups ProductCustomizationGroup[]
  allowedOptions     ProductCustomizationOption[]
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@map("products")
}

// ---------------------------------------------------------------------------
// JOIN TABLE: Product <-> Ingredient
// Replaces product.ingredientIds string array
// ---------------------------------------------------------------------------

model ProductIngredient {
  productId    String
  ingredientId String
  isRequired   Boolean    @default(true)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Restrict: ingredients must be archived (isArchived=true), not deleted.
  /// Deleting an ingredient that has active product mappings must fail at the DB level.
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([productId, ingredientId])
  @@map("product_ingredients")
}

// ---------------------------------------------------------------------------
// JOIN TABLE: Product <-> CustomizationGroup
// Replaces product.enabledCustomizationGroups string array
// ---------------------------------------------------------------------------

model ProductCustomizationGroup {
  productId String
  groupId   String
  sortOrder Int                @default(0)
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     CustomizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
  @@map("product_customization_groups")
}

// ---------------------------------------------------------------------------
// JOIN TABLE: Product <-> CustomizationOption (allowed options per product)
// Replaces product.allowedOptionIds string array
// ---------------------------------------------------------------------------

model ProductCustomizationOption {
  productId String
  optionId  String
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  option    CustomizationOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([productId, optionId])
  @@map("product_customization_options")
}

// ---------------------------------------------------------------------------
// ORDER
// CHANGED: subtotal, serviceFee, totalAmount Float -> Decimal
// PRESERVED: all existing fields
// ---------------------------------------------------------------------------

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  status          OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod   PaymentMethod
  paymentIntentId String?
  paymentMethodId String?
  qrCodeUrl       String?
  customerName    String?
  orderType       OrderType     @default(DINE_IN)
  notes           String?
  subtotal        Decimal       @db.Decimal(10, 2)
  serviceFee      Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2)
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("orders")
}

// ---------------------------------------------------------------------------
// ORDER ITEM
// CHANGED: unitPrice, subtotal Float -> Decimal
// PRESERVED: customizations Json? (backward compat for historical orders)
// ADDED:   modifiers relation -> OrderItemModifier
// ---------------------------------------------------------------------------

model OrderItem {
  id             String              @id @default(cuid())
  orderId        String
  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String
  unitPrice      Decimal             @db.Decimal(10, 2)
  quantity       Int                 @default(1)
  subtotal       Decimal             @db.Decimal(10, 2)
  customizations Json?
  notes          String?
  modifiers      OrderItemModifier[]
  createdAt      DateTime            @default(now())

  @@map("order_items")
}

// ---------------------------------------------------------------------------
// ORDER ITEM MODIFIER (NEW)
// Structured snapshot of each selected customization option per order item.
// Stores groupName/optionName/priceAdjustment as snapshot values so
// historical orders remain accurate even if catalog options are edited/deleted.
// ---------------------------------------------------------------------------

model OrderItemModifier {
  id              String               @id @default(cuid())
  orderItemId     String
  orderItem       OrderItem            @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  optionId        String?
  option          CustomizationOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  groupName       String
  optionName      String
  priceAdjustment Decimal              @db.Decimal(10, 2)
  quantity        Int                  @default(1)
  createdAt       DateTime             @default(now())

  @@map("order_item_modifiers")
}
